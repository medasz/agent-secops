# 复制为同目录下的 .env 后按实际环境填写。系统环境变量优先于本文件。

# Elasticsearch（必填）
ES_HOST=203.0.113.10
ES_PORT=9200
ES_USERNAME=sec_read
ES_PASSWORD=changeme
ES_INDEX_PREFIX=logfmt_746_

# 门户回写（可选，ENABLE_PORTAL=true 时启用）
ENABLE_PORTAL=false
PORTAL_TOKEN_APPID=
PORTAL_TOKEN_SECRET=
PORTAL_TOKEN_GRANT_TYPE=sys_credential
PORTAL_TOKEN_URL=https://portal.example.com/oncon-service/token
PORTAL_BASE_URL=portal.example.com
PORTAL_API_PATH=/oncon-service/sys_credential/save_topic_info/v1.0
PORTAL_GROUP_ID=
PORTAL_TYPE_ID=
PORTAL_EMP_ID=
PORTAL_TEMPLATE_ID=1
PORTAL_VIEW_RIGHT=2
PORTAL_REPLY_RIGHT=1
PORTAL_IS_GM_VISIBLE=false
PORTAL_VIEW_PRIV=
PORTAL_EDIT_PRIV=

# 威胁情报（可选，ENABLE_THREATBOOK=true 时启用）
ENABLE_THREATBOOK=false
THREATBOOK_API_KEY=
THREATBOOK_BASE_URL=https://api.threatbook.cn/v3
THREATBOOK_LANG=zh
THREATBOOK_CACHE_PATH=cache/threatbook.sqlite
THREATBOOK_CACHE_TTL=86400
THREATBOOK_RATE_LIMIT=10
THREATBOOK_TIMEOUT=10000
THREATBOOK_DAILY_QUOTA=150
THREATBOOK_BATCH_SIZE=100
THREATBOOK_BOUND_IP=
THREATBOOK_PROBE_IP=
THREATBOOK_CONFIRM_LEVEL=
THREATBOOK_LABEL_MAP=

# 出口代理（可选，ENABLE_PROXY=true 时启用）
ENABLE_PROXY=false
PROXY_HOST=127.0.0.1
PROXY_PORT=443
PROXY_TLS=true

# 日志级别：debug | info | warn | error
LOG_LEVEL=info
