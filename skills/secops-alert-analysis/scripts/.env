# 仓库内的示例配置，开箱即可跑测试。接真实环境时直接改本文件，凭据填自己的。

# Elasticsearch
ES_HOST=203.0.113.10
ES_PORT=9200
ES_USERNAME=sec_read
ES_PASSWORD=changeme
ES_INDEX_PREFIX=logfmt_746_

# 门户回写
ENABLE_PORTAL=false
PORTAL_TOKEN_APPID=
PORTAL_TOKEN_SECRET=
PORTAL_TOKEN_GRANT_TYPE=sys_credential
PORTAL_TOKEN_URL=https://jk.teamshub.com/oncon-service/token
PORTAL_BASE_URL=jk.teamshub.com
PORTAL_API_PATH=/oncon-service/sys_credential/save_topic_info/v1.0
PORTAL_GROUP_ID=
PORTAL_TYPE_ID=
PORTAL_EMP_ID=
PORTAL_TEMPLATE_ID=1
PORTAL_VIEW_RIGHT=2
PORTAL_REPLY_RIGHT=1
PORTAL_IS_GM_VISIBLE=false
PORTAL_VIEW_PRIV=
PORTAL_EDIT_PRIV=

# 威胁情报
ENABLE_THREATBOOK=false
THREATBOOK_API_KEY=changeme
THREATBOOK_BASE_URL=https://api.threatbook.cn/v3
THREATBOOK_LANG=zh
THREATBOOK_CACHE_PATH=cache/threatbook.sqlite
THREATBOOK_CACHE_TTL=86400
THREATBOOK_RATE_LIMIT=10
THREATBOOK_TIMEOUT=10000
THREATBOOK_DAILY_QUOTA=150
THREATBOOK_BATCH_SIZE=100
THREATBOOK_BOUND_IP=
THREATBOOK_PROBE_IP=
THREATBOOK_CONFIRM_LEVEL=
THREATBOOK_LABEL_MAP=

# 出口代理
ENABLE_PROXY=true
PROXY_HOST=192.0.2.34
PROXY_PORT=443
PROXY_TLS=true

# 日志级别：debug | info | warn | error
LOG_LEVEL=info
